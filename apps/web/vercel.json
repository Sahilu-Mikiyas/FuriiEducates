{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://furii-school-api.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/teach/:path*",
      "destination": "/"
    },
    {
      "source": "/learn/:path*",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    }
  ]
}
