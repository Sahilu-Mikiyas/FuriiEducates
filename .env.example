DATABASE_URL=postgres://furii:furii-dev-only@localhost:5432/furii?sslmode=disable
HTTP_ADDR=:8080
SESSION_HASH_KEY=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
# lax, strict, or none. Defaults to none with secure cookies, otherwise lax.
COOKIE_SAMESITE=
# true behind a reverse proxy that sets X-Forwarded-For (Render, Vercel).
TRUST_PROXY_HEADERS=false
SESSION_TTL=12h
# Exact comma-separated frontend origins. Required even behind the /api proxy,
# because the proxy forwards the browser's Origin header. Production lists the
# Vercel origin; local development uses the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional comma-separated emails allowed to access the product walkthrough inbox.
DEMO_REQUEST_ADMIN_EMAILS=
